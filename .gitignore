# Build output
/build/
/build-*/
/out/
/install/
CMakeUserPresets.json
compile_commands.json
.cache/

# Editor / tooling state
/.claude/
/.vscode/
/.idea/
*.user
*.autosave

# Reference captures of third-party UIs (tools/refcap).
# Someone else's pixels and markup: fine to study locally, not ours to
# redistribute. What belongs in git is the distilled measurements —
# see docs/09-reference-capture.md.
/reference/
/tools/refcap/node_modules

# What `scripts/golden.sh check` writes beside an image that did not match. It
# is the rendering the run produced, for looking at; the recorded image is the
# one in git. Committing one by accident replaces a golden with the thing it was
# supposed to catch.
tests/golden/images/*.actual.png

# OS cruft
.DS_Store
Thumbs.db

# Mission Control Recall (project memory) — private, do not commit
CLAUDE.local.md
