#
# A launcher entry for the widget host, so that the tiles can be opened on a
# desktop whose shell has no way to pin them.
#
# ---- who this is for --------------------------------------------------------
#
# On GNOME the tiles are launched and pinned by the shell extension, and this
# entry is not how anybody gets them. It is for everywhere else: KDE, Sway,
# Hyprland, XFCE.
#
# `Exec` carries no flags because it does not need any. `--pin` defaults to
# `auto`, so on a compositor that implements zwlr_layer_shell_v1 — KWin and
# every wlroots compositor — starting this from the application menu produces
# tiles pinned to the desktop, top-right, under every window. Where the
# protocol is absent it produces an ordinary window instead, which is what an
# X11 desktop gets and what a GNOME user gets if they start this by hand rather
# than enabling the extension. See packaging/plasma/README.md.
#
# There is deliberately no autostart entry beside this one. The daemon
# autostarts because it is a service; whether weather tiles appear on somebody's
# desktop at every login is their decision, and it is a copy of this file into
# ~/.config/autostart/.
#
# ---- the filename -----------------------------------------------------------
#
# @CLIMA_APP_ID@.Widget.desktop, matching the desktop file name the host sets in
# QGuiApplication::setDesktopFileName() (widgets/main.cpp). A surface whose
# app_id has no matching entry gets a generic icon and "Unknown application"
# under Wayland; one that claimed the app's own id would put a second Clima in
# the dock.

[Desktop Entry]
Type=Application
Version=1.5

Name=Clima widgets
GenericName=Weather widgets
Comment=Weather tiles for the desktop

Exec=clima-widget
Icon=@CLIMA_APP_ID@
Terminal=false

Categories=Utility;
Keywords=Weather;Widget;Desktop;Forecast;

StartupNotify=true
StartupWMClass=clima-widget

# Linux desktops only, for the same reason as the daemon's entry: the host reads
# from a session bus, and there is not one anywhere else.
OnlyShowIn=GNOME;KDE;XFCE;MATE;Cinnamon;LXQt;Budgie;Unity;Pantheon;
