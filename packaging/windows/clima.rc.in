//
// The Windows resource script, generated by CMake from this template.
//
// Two things live here and both are things Windows reads off the executable
// itself rather than out of any installer:
//
//   * The icon. Without it Explorer, the taskbar and Alt-Tab draw the default
//     application icon on clima.exe no matter what the MSI installed into the
//     Start Menu, because a shortcut's icon and a binary's icon are different
//     pieces of metadata. This is the one people notice.
//
//   * VERSIONINFO. It is what the Properties dialog shows, what SmartScreen
//     quotes when it warns about an unsigned binary, and what a corporate
//     software inventory reads. An executable with no version block reads as
//     anonymous, which is the worst possible look for something already
//     unsigned — see docs/known-gaps.md.
//
// The `1` on the ICON line is not decorative: Windows uses the lowest-numbered
// icon resource as the application icon, so it has to be first and it has to
// be a small number.

#include <winresrc.h>

1 ICON "@CLIMA_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @CLIMA_VERSION_RC@
PRODUCTVERSION @CLIMA_VERSION_RC@
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 is US English, 04b0 is UTF-16. The pair has to match the
        // Translation value at the bottom of the file or the whole block is
        // ignored, silently, and the Properties dialog comes up blank.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Jowi Aoun"
            VALUE "FileDescription",  "Clima weather"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "clima"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Jowi Aoun. GNU GPL v3 or later."
            VALUE "OriginalFilename", "clima.exe"
            VALUE "ProductName",      "Clima"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
